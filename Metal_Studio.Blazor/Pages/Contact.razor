@page "/contact"

<PageTitle>Metal Studio — Contact</PageTitle>

<div class="container py-5">

    <!-- Header -->
    <div class="text-center mb-5">

        <h1 class="display-4 fw-bold">
            Let's Work Together
        </h1>

        <p class="lead text-muted mx-auto" style="max-width:700px;">
            Whether you have a project, freelance opportunity, collaboration,
            or simply want to ask a question, I'd be happy to hear from you.
            I usually respond within 24 hours.
        </p>

    </div>

    <!-- Contact Cards -->
    <div class="row g-4">

        <!-- Email -->
        <div class="col-md-6 col-xl-4">

            <div class="card border-0 shadow-sm h-100 text-center">

                <div class="card-body p-4">

                    <i class="bi bi-envelope-fill display-3 text-primary"></i>

                    <h4 class="mt-4">
                        Email
                    </h4>

                    <p class="text-muted">
                        Best for project discussions and business inquiries.
                    </p>

                    <a class="btn btn-primary w-100"
                       href="https://mail.google.com/mail/?view=cm&fs=1&to=boba.mega122@gmail.com"
                       target="_blank">

                        <i class="bi bi-envelope me-2"></i>
                        Email Me

                    </a>

                </div>

            </div>

        </div>

        <!-- WhatsApp -->
        <div class="col-md-6 col-xl-4">

            <div class="card border-0 shadow-sm h-100 text-center">

                <div class="card-body p-4">

                    <i class="bi bi-whatsapp display-3 text-success"></i>

                    <h4 class="mt-4">
                        WhatsApp
                    </h4>

                    <p class="text-muted">
                        Perfect for quick questions and conversations.
                    </p>

                    <a class="btn btn-success w-100"
                       href="https://wa.me/01284414769"
                       target="_blank">

                        <i class="bi bi-whatsapp me-2"></i>
                        Chat Now

                    </a>

                </div>

            </div>

        </div>

        <!-- GitHub -->
        <div class="col-md-6 col-xl-4">

            <div class="card border-0 shadow-sm h-100 text-center">

                <div class="card-body p-4">

                    <i class="bi bi-github display-3"></i>

                    <h4 class="mt-4">
                        GitHub
                    </h4>

                    <p class="text-muted">
                        Explore my projects, source code, and open-source work.
                    </p>

                    <a class="btn btn-dark w-100"
                       href="https://github.com/boba1010"
                       target="_blank">

                        <i class="bi bi-github me-2"></i>
                        View GitHub

                    </a>

                </div>

            </div>

        </div>

    </div>

    <!-- Availability -->
    <div class="card border-0 shadow-sm mt-5">

        <div class="card-body p-5">

            <div class="row align-items-center">

                <div class="col-lg-8">

                    <h3 class="fw-bold">
                        Availability
                    </h3>

                    <p class="text-muted mb-0">
                        I'm currently available for freelance projects,
                        desktop application development, backend systems,
                        WinUI applications, and technical collaborations.
                    </p>

                </div>

                <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">

                    <span class="badge bg-success fs-6 px-4 py-3">
                        ● Available for Work
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>