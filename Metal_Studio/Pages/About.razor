@page "/about"

<PageTitle>Metal Studio — About</PageTitle>

<div class="p-sm-5">

    <section class="mb-5">
        <h1 class="display-4 fw-bold">
            About Me
        </h1>

        <p class="lead text-muted">
            I'm a 14-year-old solo developer building native Windows apps,
            low-level graphics APIs, game engines, and web software from scratch in C#.
        </p>
    </section>


    <section class="mb-5">
        <h2 class="fw-bold mb-4">
            What I Build
        </h2>

        <div class="row g-4">

            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h4>Desktop Development</h4>
                        <p>
                            Native Windows applications using WinUI, .NET,
                            and low-level Windows technologies.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h4>Cross-Platform Development</h4>
                        <p>
                            Multi-platform applications built with .NET MAUI,
                            delivering native experiences across supported platforms.
                        </p>
                    </div>
                </div>
            </div>


            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h4>Web Development</h4>
                        <p>
                            Interactive web applications using Blazor
                            and ASP.NET Core.
                        </p>
                    </div>
                </div>
            </div>


            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h4>Backend Systems</h4>
                        <p>
                            APIs, authentication systems, databases,
                            and application logic.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </section>


    <section class="mb-5">
        <h2 class="fw-bold">
            Technologies
        </h2>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <span class="badge text-bg-primary">C#</span>
            <span class="badge text-bg-primary">.NET</span>
            <span class="badge text-bg-primary">ASP.NET Core</span>
            <span class="badge text-bg-primary">Blazor</span>
            <span class="badge text-bg-primary">WinUI</span>
            <span class="badge text-bg-primary">MAUI</span>
        </div>
    </section>


    <section>
        <div class="card shadow-sm p-4">
            <h3>
                Interested in working together?
            </h3>

            <p>
                Check out my projects or get in touch.
            </p>

            <div class="w-100 d-flex gap-3">
                <NavLink class="btn btn-primary w-100" href="/contact">
                    Contact Me
                </NavLink>
                <NavLink class="btn btn-primary w-100" href="/projects">
                    View Projects
                </NavLink>
            </div>
        </div>
    </section>

</div>