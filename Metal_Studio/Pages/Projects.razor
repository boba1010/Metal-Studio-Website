@page "/projects"
@using Metal_Studio.Components
@using Metal_Studio.Repos


<PageTitle>Metal Studio — Projects</PageTitle>

<div class="p-sm-5">

    <div class="mb-5" style="padding: 0 15px;">
        <h1 class="display-4 fw-bold">
            My Projects
        </h1>

        <p class="lead text-muted">
            A collection of applications, tools, and systems I have built using .NET, and modern technologies.
        </p>
    </div>


    <div class="row g-4">

        @foreach (var project in ProjectsRepo.Projects)
        {
            <div class="col-lg-4 col-md-6">
                <ProjectCard Project="project" />
            </div>
        }
    </div>

</div>